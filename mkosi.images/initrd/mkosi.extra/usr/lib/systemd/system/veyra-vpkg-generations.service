[Unit]
Description=Mount the Veyra vpkg system generation before switch-root
DefaultDependencies=no
After=sysroot.mount sysroot-etc.mount sysroot-var.mount
Requires=sysroot.mount sysroot-etc.mount sysroot-var.mount
RequiresMountsFor=/sysefi
Before=initrd-root-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /usr/libexec/veyra-vpkg-initrd.py

[Install]
RequiredBy=initrd-root-fs.target
