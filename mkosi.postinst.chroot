#!/usr/bin/bash
set -euo pipefail

# Install Flathub as a normal system app source for Discover. The official
# .flatpakrepo, including its signing key, is vendored so this build step works
# without network access inside mkosi's finalization sandbox.
flatpak remote-add --system --if-not-exists flathub \
    /usr/share/veyra/flathub.flatpakrepo

# Select the lightweight Veyra splash for the initrd generated by mkosi.
# Do not regenerate an initrd here; mkosi owns the boot artifact lifecycle.
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme veyra
else
    echo "plymouth-set-default-theme missing; refusing an unbranded boot" >&2
    exit 1
fi
