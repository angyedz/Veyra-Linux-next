#!/usr/bin/env bash
set -euo pipefail

case "${IMAGE_ID:-}" in
    veyra-recovery)
        install -D -m 0755 "$SRCDIR/scripts/veyra_recovery.py" \
            "$BUILDROOT/usr/libexec/veyra-recovery"
        ;;
    veyra-next)
        python3 "$SRCDIR/scripts/install_recovery_uki.py" \
            --root "$BUILDROOT" \
            --output-dir "$SRCDIR/mkosi.output"
        release="$BUILDROOT/usr/lib/veyra/os-release"
        sed -i '/^IMAGE_ID=/d; /^IMAGE_VERSION=/d' "$release"
        printf 'IMAGE_ID="%s"\nIMAGE_VERSION="%s"\n' \
            "$IMAGE_ID" "$IMAGE_VERSION" >> "$release"
        ;;
esac
