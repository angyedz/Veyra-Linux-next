#!/usr/bin/env bash
set -euo pipefail

case "${IMAGE_ID:-}" in
    veyra-recovery)
        # Recovery code must be present BEFORE the initrd and UKI are packed.
        # The canonical source is mirrored into mkosi.images/recovery/mkosi.extra
        # and source tests enforce byte-for-byte equality. Installing into the
        # final build root at this point is too late for a standalone UKI.
        ;;
    veyra-next)
        python3 "$SRCDIR/scripts/install_recovery_uki.py" \
            --root "$BUILDROOT" \
            --output-dir "$SRCDIR/mkosi.output"
        release="$BUILDROOT/usr/lib/veyra/os-release"
        sed -i '/^IMAGE_ID=/d; /^IMAGE_VERSION=/d' "$release"
        printf 'IMAGE_ID="%s"\nIMAGE_VERSION="%s"\n' \
            "$IMAGE_ID" "$IMAGE_VERSION" >> "$release"
        ;;
esac
